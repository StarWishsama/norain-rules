---
name: Stash Override
desc: Stash 通用 Mixin 配置 @NoRainCity
author: StarWishsama (NoRainCity)
category: Mixin

dns:
  follow-rule: true
  default-nameserver: #!replace
    - 119.29.29.29
    - 223.5.5.5
  proxy-server-nameserver: #!replace
    - 119.29.29.29
    - 223.5.5.5
    - 8.8.4.4
  nameserver: #!replace
    - https://doh.pub/dns-query#h3=true
    - tls://dns.alidns.com#h3=true
  nameserver-policy: #!replace
    dns.alidns.com: 223.5.5.5
    dot.pub: 119.29.29.29
    doh.pub: 119.29.29.29
    dns.pub: 119.29.29.29
    doh.360.cn: 101.198.198.198
    cloudflare-dns.com: 1.1.1.1
    dns.google: 8.8.8.8
    "+.lan": system
    "+.in-addr.arpa": system
    "cable.auth.com": system
    miwifi.net: system
    "geosite:apple@cn,apple-music@cn": 
      - 223.5.5.5
      - https://doh.pub/dns-query#h3=true
    "geosite:gfw,category-ai-!cn,category-cdn-!cn":
      - https://dns.google/dns-query#h3=true
      - https://cloudflare-dns.com/dns-query#h3=true
    "+.game-gakuen-idolmaster.jp":
      - https://dns.google/dns-query#h3=true
      - https://cloudflare-dns.com/dns-query#h3=true
  fake-ip-filter: #!replace
