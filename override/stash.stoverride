rule-providers: #!replace
  GitHub:
    type: http
    behavior: domain
    format: text
    path: ./Rule/GitHub.list
    url: https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/github.list
    interval: 3600
  Google:
    type: http
    behavior: domain
    format: text
    path: ./Rule/Google.list
    url: https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/google.list
    interval: 3600
  Netflix:
    type: http
    behavior: domain
    format: text
    path: ./Rule/Netflix.list
    url: https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/netflix.list
    interval: 3600
  AI:
    type: http
    behavior: domain
    path: ./Rule/AI.list
    url: https://cdn.jsdelivr.net/gh/QuixoticHeart/rule-set@ruleset/stash/domain/ai.list
    format: text
    interval: 3600
  apple:
    type: http
    url: https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/apple.list
    behavior: domain
    format: text
    interval: 7200   
  apple-cn:
    type: http
    url: https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/apple@cn.list
    behavior: domain
    format: text
    interval: 7200
  steam@cn:
    type: http
    url: https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/steam%40cn.list
    behavior: domain
    format: text
    interval: 7200 
  dmm:
    type: http
    url: https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/dmm.list
    behavior: domain
    format: text
    interval: 7200
  HTTPDNS:
    type: http
    url: https://cdn.jsdelivr.net/gh/QuixoticHeart/rule-set@ruleset/stash/httpdns.list
    behavior: domain
    format: text
    interval: 7200
  AntiAD:
    type: http
    url: https://gcore.jsdelivr.net/gh/TG-Twilight/AWAvenue-Ads-Rule@main/Filters/AWAvenue-Ads-Rule-Clash-Only.Ads.yaml
    behavior: domain
    format: yaml
    interval: 7200
  CN:
    type: http
    url: https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/cn.list
    behavior: domain
    format: text
    interval: 7200  
  HKBANK:
    type: http
    url: https://cdn.jsdelivr.net/gh/Accademia/Additional_Rule_For_Clash@main/Bank/BankHK_Domain.yaml
    behavior: domain
    format: yaml
    interval: 72000
  ASNCN:
    type: http
    url: https://cdn.jsdelivr.net/gh/missuo/ASN-China@main/ASN.China.list
    behavior: classical
    format: text
    interval: 72000
  AppleAI:
    type: http
    behavior: domain
    format: text
    path: ./Rule/AppleAI.list
    url: https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/apple-intelligence.list
    interval: 7200
         
rules: #!replace
  - DOMAIN,dns.alidns.com,DIRECT
  - DOMAIN,doh.pub,DIRECT
  - DOMAIN,ua-check.stagoh.com,DIRECT
  - DOMAIN,stun.chat.bilibili.com,REJECT,no-track

  # 强制海外 DNS 走代理
  - DOMAIN,dns.google,Proxy
  - DOMAIN,cloudflare-dns.com,Proxy

  - RULE-SET,HTTPDNS,HTTPDNS,no-track
  - RULE-SET,AntiAD,AntiAD

  - GEOIP,private,DIRECT,no-resolve

  # Apple Intelligence
  - RULE-SET,AppleAI,AppleAI

  - GEOSITE,category-ai-!cn,AI
  - RULE-SET,AI,AI

  - RULE-SET,apple-cn,AppleCN
  - RULE-SET,steam@cn,Steam@CN

  # Bilibili 使用独立策略组，优先于国内服务兜底
  - GEOSITE,bilibili,Bilibili

  # YouTube 与 Google 规则集有重叠，必须先匹配
  - GEOSITE,youtube,YouTube
  - RULE-SET,Google,Google
  - RULE-SET,GitHub,GitHub
  - RULE-SET,apple,Apple
  - RULE-SET,HKBANK,HK Bank
  - GEOSITE,microsoft,Microsoft

  - RULE-SET,dmm,DMM
  - DOMAIN-SUFFIX,game-gakuen-idolmaster.jp,Gakumas

  - RULE-SET,Netflix,Netflix
  - GEOSITE,speedtest,Speedtest
  - GEOSITE,steam,Steam
  - GEOSITE,spotify,Spotify
  - GEOSITE,telegram,Telegram
  - GEOSITE,x,Twitter
  - GEOSITE,paypal,Paypal

  - RULE-SET,ASNCN,Mainland,no-resolve
  - RULE-SET,CN,Mainland
  - GEOIP,cn,Mainland

  - MATCH,Fallback