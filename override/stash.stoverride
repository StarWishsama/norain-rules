proxy-groups: #!replace
  - name: Proxy
    type: select
    icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Proxy.png
    
    proxies:
      - Manual
      - US
      - SG
      - HK
      - TW
      - JP

  - name: Manual
    type: select
    icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Static.png
    include-all: true

  - name: US
    type: select
    icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/US.png
    filter: (🇺🇸|US|USA|America|america|United States|美国|凤凰城|洛杉矶|西雅图|芝加哥|纽约|沪美|美)
    include-all: true

  - name: SG
    type: select
    icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/SG.png
    filter: (新加坡|SG|Singapore|狮城|SGN)
    include-all: true

  - name: HK
    type: select
    icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/HK.png
    filter: (🇭🇰|HK|Hong|hong|香港|深港|沪港|京港|港)
    include-all: true

  - name: TW
    type: select
    icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/TW.png
    filter: (🇹🇼|TW|TWN|Taiwan|Taipei|taiwan|台湾|台灣|台北|台中|新北|彰化)
    include-all: true

  - name: JP
    type: select
    icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/JP.png
    filter: (🇯🇵|JP|Japan|japan|Tokyo|tokyo|日本|东京|大阪)
    include-all: true

  - name: HTTPDNS
    type: select
    icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Server.png

    proxies:
      - Proxy
      - DIRECT
      - REJECT
      - REJECT-DROP 

  - name: AntiAD
    type: select
    icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Advertising.png

    proxies:
      - REJECT
      - Proxy
      - DIRECT
      - REJECT-DROP

  - name: HK Bank
    type: select    
    icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/HK.png
    proxies:
      - DIRECT
      - Proxy
      - Manual
      - HK
      
  - name: Mainland
    type: select
    icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/China.png

    proxies:
      - DIRECT
      - Proxy

  - name: Bilibili
    type: select
    icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/bilibili.png

    proxies:
      - DIRECT
      - Proxy
      - Manual
      - US
      - SG
      - HK
      - TW
      - JP
  - name: Speedtest
    type: select
    icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Speedtest.png

    proxies:
      - Proxy
      - Manual
      - US
      - SG
      - HK
      - TW
      - JP
      - DIRECT

  - name: APNS
    type: select
    icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Apple.png

    proxies:
      - DIRECT
      - Proxy
